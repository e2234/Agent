# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
# Optional: override the classification model (defaults to claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# Optional: name of the root folder created in the user's My Drive to hold
# the organized-by-class subfolders.
ORGANIZE_ROOT_FOLDER_NAME=Organized by Class
